# ============================================================
#  Integração Mercado Livre — APP Agro Peças Padrão
#  Copie para a raiz do projeto (.env) e preencha.
# ============================================================

# --- Shopify Admin API (origem dos produtos) ---
# Crie um app customizado em: Shopify Admin > Settings > Apps and sales channels
# > Develop apps > Create an app > Admin API access token (shpat_...)
# Scopes necessários: read_products, write_products, read_inventory
SHOPIFY_STORE=agropecaspadrao-2.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# --- Mercado Livre (developers.mercadolivre.com.br) ---
# Estas duas você já tem no .env atual (ML-APP-ID / ML-KEY-SECRET).
# O config lê tanto a forma com hífen quanto com underscore.
ML_APP_ID=0000000000000000
ML_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cadastre EXATAMENTE esta URL como "Redirect URI" no painel do app ML:
ML_REDIRECT_URI=https://localhost:8765/callback
ML_SITE=MLB

# --- EAN / GTIN (qualidade máxima de anúncio) ---
# Prefixo de empresa GS1 (GS1 Brasil). Sem ele, os EAN gerados são
# apenas internos (não globais). Ex.: 789XXXXXX  (7-9 dígitos)
GS1_PREFIX=
