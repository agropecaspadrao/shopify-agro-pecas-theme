# Carol — variáveis de ambiente
# Em produção (Railway/Render), configure estas variáveis no painel do serviço.
# Em desenvolvimento local, o serviço também lê o .env da raiz do repositório.

# Claude API (obrigatória)
ANTHROPIC_API_KEY=
# Modelo (opcional, padrão claude-opus-4-8)
# CAROL_MODEL=claude-opus-4-8

# WhatsApp Cloud API (obrigatórias para o WhatsApp; o widget do site funciona sem elas)
# ID do número de telefone no WhatsApp Manager (não é o número em si)
WA_PHONE_NUMBER_ID=
# Token de sistema com permissões whatsapp_business_messaging e whatsapp_business_management
# (pode reusar META_SYSTEM_USER_TOKEN do .env da raiz, se tiver essas permissões)
WA_ACCESS_TOKEN=
# Token qualquer que você inventa e repete na configuração do webhook na Meta
WA_VERIFY_TOKEN=
# App secret do app Meta (valida a assinatura dos webhooks)
META_APP_SECRET=
# Número da loja (para ignorar ecos no modo coexistência)
# WA_BUSINESS_NUMBER=5541984151085

# Loja / widget
# CAROL_SHOP_URL=https://agropecaspadrao.com.br
# CAROL_ALLOWED_ORIGINS=https://agropecaspadrao.com.br,https://www.agropecaspadrao.com.br

# Horário comercial da Dai (padrão: seg-sex 8h às 18h, Brasília)
# CAROL_HORA_INICIO=8
# CAROL_HORA_FIM=18

# ── Monitoramento, alertas e comandos (agente de operação) ─────────────────
# E-mail por HTTP (o Railway bloqueia SMTP em qualquer plano). Ordem de
# tentativa: Gmail API (conta de serviço com delegação no Workspace, sai pelo
# Google da empresa) → Resend → Brevo → SMTP (só local).
GOOGLE_SERVICE_ACCOUNT_JSON=   # JSON (ou base64) da conta de serviço carol-monitor@...
GMAIL_SENDER=                  # usuário real do Workspace a impersonar, ex. admin@agropecaspadrao.com.br
RESEND_API_KEY=
BREVO_API_KEY=
# Remetente (precisa estar verificado no provedor) e nome de exibição
# EMAIL_FROM=carol@agropecaspadrao.com.br
# EMAIL_FROM_NAME=Carol - Agro Peças Padrão

# Destinatários (separar por vírgula)
# REPORT_TO=comercial@agropecaspadrao.com.br                              # relatório da Dai, 8h
# SOCIOS_EMAILS=socios@agropecaspadrao.com.br,admin@agropecaspadrao.com.br # relatório executivo, 8h05, e palavra-chave
# ALERTA_EMAILS=admin@agropecaspadrao.com.br,socios@agropecaspadrao.com.br # anomalias ("Urgente Carol")

# Números de WhatsApp dos administradores (formato 5541999999999), separados
# por vírgula. Só eles usam "/carol" e recebem alertas por WhatsApp.
CAROL_ADMINS=

# Token reserva do WhatsApp (permanente, diferente do principal). Se o
# principal expirar, a Carol troca sozinha e avisa.
WA_ACCESS_TOKEN_FALLBACK=

# Verificações de saúde (opcionais; sem elas o bloco aparece como "não configurado")
# META_ACCESS_TOKEN=            # token de página permanente com ads_read (campanhas + validade)
# META_AD_ACCOUNT_ID=           # act_... ou só o número
# GOOGLE_ADS_CLIENT_ID=         # só para validar o refresh token
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# (GOOGLE_SERVICE_ACCOUNT_JSON acima também serve para ler a planilha master)
# MASTER_DRIVE_FILE_ID=1FoyfpY5E4Z4dYcEk7hiP2Jrg_dts6teu
# SAUDE_INTERVALO_MIN=30
# Saldo Anthropic: saldo do console na data abaixo; a Carol desconta o uso registrado desde então.
# Atualizar os dois a cada recarga, senão o aviso de saldo baixo fica errado.
# CAROL_CREDITO_USD=3.37
# CAROL_CREDITO_DESDE=2026-09-16T12:18:07Z
# CAROL_ALERTA_SALDO_USD=0.5
# INVENTARIO_DIAS_ALERTA=30

# Horários (Brasília)
# RELATORIO_DAI_HORA=8
# RELATORIO_SOCIOS_HORA=8
# RELATORIO_SOCIOS_MINUTO=5
# CHAVE_DIA_SEMANA=1            # 1 = segunda
# CHAVE_HORA=7
# CHAVE_MINUTO=55
# AGENDA_JANELA_RECUPERACAO_H=6 # tarefa perdida ainda roda se atrasar menos que isto
