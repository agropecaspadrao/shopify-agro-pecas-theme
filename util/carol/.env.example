# Carol — variáveis de ambiente
# Em produção (Railway/Render), configure estas variáveis no painel do serviço.
# Em desenvolvimento local, o serviço também lê o .env da raiz do repositório.

# Claude API (obrigatória)
ANTHROPIC_API_KEY=
# Modelo (opcional, padrão claude-opus-4-8)
# CAROL_MODEL=claude-opus-4-8

# WhatsApp Cloud API (obrigatórias para o WhatsApp; o widget do site funciona sem elas)
# ID do número de telefone no WhatsApp Manager (não é o número em si)
WA_PHONE_NUMBER_ID=
# Token de sistema com permissões whatsapp_business_messaging e whatsapp_business_management
# (pode reusar META_SYSTEM_USER_TOKEN do .env da raiz, se tiver essas permissões)
WA_ACCESS_TOKEN=
# Token qualquer que você inventa e repete na configuração do webhook na Meta
WA_VERIFY_TOKEN=
# App secret do app Meta (valida a assinatura dos webhooks)
META_APP_SECRET=
# Número da loja (para ignorar ecos no modo coexistência)
# WA_BUSINESS_NUMBER=5541984151085

# Loja / widget
# CAROL_SHOP_URL=https://agropecaspadrao.com.br
# CAROL_ALLOWED_ORIGINS=https://agropecaspadrao.com.br,https://www.agropecaspadrao.com.br

# Horário comercial da Dai (padrão: seg-sex 8h às 18h, Brasília)
# CAROL_HORA_INICIO=8
# CAROL_HORA_FIM=18
# Carol 24h (a partir do lançamento do SDR comercial): responde em qualquer
# horário; a Dai acompanha só o que esquenta, pelo painel do SDR.
# CAROL_24H=1
# ATENÇÃO: as três variáveis acima são só o VALOR INICIAL. Depois que alguém
# salva o horário pelo SDR (seção Carol), vale o que está em
# DATA_DIR/horario.json e estas variáveis deixam de ter efeito.
# Para pausar a Carol por algumas horas não mexa aqui: use o botão Desligar no
# SDR (seção Carol) ou, em emergência, "/carol pausar" pelo WhatsApp.

# ── Administração (SDR → seção Carol) ──────────────────────────────────────
# A Carol não tem mais painel próprio: /admin/painel e /admin/dashboard
# redirecionam para o SDR comercial, o portal único da operação. O SDR chama
# a API JSON /admin/api/* servidor→servidor com
#   Authorization: Bearer <CAROL_ADMIN_KEY>
# (a mesma chave fica configurada no SDR). NUNCA na URL: ?key= não é aceito.
CAROL_ADMIN_KEY=
# Endereço da seção Carol no SDR (para onde vão /admin/painel e /admin/dashboard,
# e o link dos e-mails de alerta e do /carol ajuda)
# CAROL_PORTAL_URL=https://sdr-backend-production.up.railway.app/sdr/admin/carol
# Limite de requisições por IP em /admin/api a cada 10 min (o SDR faz polling
# de 5 s por aba; 3000 cobre ~10 abas abertas)
# CAROL_API_LIMITE_10MIN=3000
# Tetos diários exibidos no SDR (e aplicados no atendimento)
# CAROL_MAX_MSGS_WA_DIA=300
# CAROL_MAX_MSGS_WA_TEL_DIA=40
# CAROL_MAX_MSGS_SITE_DIA=400
# CAROL_MAX_MSGS_SITE_IP_DIA=60        # por IP (IPv6 conta por /64)
# CAROL_MAX_MSGS_SITE_SESSAO_DIA=40    # por sessão do widget
# Os tetos contam por dia do calendário (São Paulo) e ficam em DATA_DIR/tetos.json
# (sobrevivem a deploy). Acima de 80% do teto do site, só sessões que já
# conversaram hoje continuam.
# Mensagens seguidas do mesmo cliente que chegam dentro desta janela viram uma
# entrada só (uma resposta por vez por telefone)
# CAROL_AGRUPAR_MS=4000
# Métricas da máquina vistas pelo Railway (opcional). Token criado em
# Project Settings > Tokens (tipo projeto) ou Account Settings > Tokens (conta).
# RAILWAY_SERVICE_ID e RAILWAY_ENVIRONMENT_ID o Railway injeta sozinho.
# RAILWAY_API_TOKEN=
# RAILWAY_TOKEN_TIPO=projeto    # projeto (header Project-Access-Token) ou conta (Authorization: Bearer)

# Espaçamento entre mensagens para o MESMO telefone (a Meta recusa rajadas, erro 131056)
# WA_ESPACO_MS=2000
# WA_ESPERA_LIMITE_MS=6000

# ── Monitoramento, alertas e comandos (agente de operação) ─────────────────
# E-mail só por HTTP (o Railway bloqueia SMTP em qualquer plano; o SMTP/nodemailer
# foi removido). Ordem de tentativa: Gmail API (conta de serviço com delegação no
# Workspace, sai pelo Google da empresa) → Resend → Brevo.
GOOGLE_SERVICE_ACCOUNT_JSON=   # JSON (ou base64) da conta de serviço carol-monitor@...
GMAIL_SENDER=                  # usuário real do Workspace a impersonar, ex. admin@agropecaspadrao.com.br
RESEND_API_KEY=
BREVO_API_KEY=
# Remetente (precisa estar verificado no provedor) e nome de exibição
# EMAIL_FROM=carol@agropecaspadrao.com.br
# EMAIL_FROM_NAME=Carol - Agro Peças Padrão

# Destinatários (separar por vírgula)
# REPORT_TO=comercial@agropecaspadrao.com.br                              # relatório da Dai, 8h
# SOCIOS_EMAILS=socios@agropecaspadrao.com.br,admin@agropecaspadrao.com.br # relatório executivo, 8h05, e palavra-chave
# ALERTA_EMAILS=admin@agropecaspadrao.com.br,socios@agropecaspadrao.com.br # anomalias ("Urgente Carol")

# Números de WhatsApp dos administradores (formato 5541999999999), separados
# por vírgula. Só eles usam "/carol" e recebem alertas por WhatsApp.
CAROL_ADMINS=

# Token reserva do WhatsApp (permanente, diferente do principal). Se o
# principal expirar, a Carol troca sozinha e avisa.
WA_ACCESS_TOKEN_FALLBACK=

# Verificações de saúde (opcionais; sem elas o bloco aparece como "não configurado")
# META_ACCESS_TOKEN=            # token de página permanente com ads_read (campanhas + validade)
# META_AD_ACCOUNT_ID=           # act_... ou só o número
# GOOGLE_ADS_CLIENT_ID=         # só para validar o refresh token
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# (GOOGLE_SERVICE_ACCOUNT_JSON acima também serve para ler a planilha master)
# MASTER_DRIVE_FILE_ID=1FoyfpY5E4Z4dYcEk7hiP2Jrg_dts6teu
# SAUDE_INTERVALO_MIN=30
# Saldo Anthropic: saldo do console na data abaixo; a Carol desconta o gasto desde então
# (contador persistente em DATA_DIR/gasto.json). Preferível: depois de recarregar, mandar
# "/carol saldo <valor>" (vale mais que estas variáveis e não precisa de deploy).
# CAROL_CREDITO_USD=3.37
# CAROL_CREDITO_DESDE=2026-09-16T12:18:07Z
# CAROL_ALERTA_SALDO_USD=0.5
# INVENTARIO_DIAS_ALERTA=30

# Horários (Brasília)
# RELATORIO_DAI_HORA=8
# RELATORIO_SOCIOS_HORA=8
# RELATORIO_SOCIOS_MINUTO=5
# CHAVE_DIA_SEMANA=1            # 1 = segunda
# CHAVE_HORA=7
# CHAVE_MINUTO=55
# AGENDA_JANELA_RECUPERACAO_H=6 # tarefa perdida ainda roda se atrasar menos que isto

# Integração com o SDR comercial (app-agente-sdr). Contrato:
#   - espelho (Carol → SDR): POST SDR_SYNC_URL com header X-Carol-Key: <SDR_SYNC_KEY>,
#     corpo { ts, canal, sessao, mensagem, resposta, origem?, tipo?, entregue?, motivo?, autor? }
#     tipo: ausente (IA) | falha | silencio | humano (resposta da equipe no app) | aviso
#   - webhook encaminhado pelo messenger do SDR: header X-SDR-Possuidos (fora do HMAC)
#     lista os telefones das conversas do SDR; a Carol ignora essas mensagens
#   - histórico (SDR → Carol): GET /admin/exportar?dias=90&formato=json com
#     Authorization: Bearer <SDR_SYNC_KEY> (essa chave SÓ lê a exportação)
# SDR_SYNC_KEY precisa ser IGUAL na Carol e no SDR. Sem ela, durante a transição,
# o espelho usa CAROL_ADMIN_KEY (com aviso no log). SDR_SYNC_URL tem que ser
# https:// (http só para localhost). Vazio = espelho desligado.
# SDR_SYNC_URL=https://sdr-backend-production.up.railway.app/sdr/api/sdr/historico/carol/turno
# SDR_SYNC_KEY=

# Diretório de dados (registro, memória local, tetos, gasto, horário, pausa, auditoria). No Railway,
# aponte para o volume montado; padrão: util/carol/data
# CAROL_DATA_DIR=/app/data

# ── Memória de conversa (src/memoria) ─────────────────────────────────────
# Postgres dedicado. Vazio = memória local (registro JSONL de 7 dias); se o
# banco cair, a Carol segue com a memória local e avisa (anomalia memoria_degradada).
# DATABASE_URL=postgresql://usuario:senha@host:5432/carol
# DATABASE_SSL=1                    # só se o provedor exigir TLS (aceita certificado próprio)
# CAROL_EPISODIO_OCIOSO_MIN=120     # conversa parada há N min vira episódio (resumo do Haiku)
# CAROL_EPISODIO_INTERVALO_MIN=10   # de quanto em quanto tempo o job procura conversas paradas
# CAROL_CONTEXTO_DIAS=7             # episódios completos por N dias; depois só a ficha
# CAROL_FICHA_DIAS=180              # ficha apagada após N dias sem contato
# CAROL_REGISTRO_DIAS=90            # registro-*.jsonl apagado após N dias (limpeza das 3h)
# CAROL_MODELO_MEMORIA=claude-haiku-4-5
# Só para testes de integração locais:
# CAROL_TEST_DATABASE_URL=postgresql://localhost:5433/carol_memoria_test
