{%- comment -%}
  Ícones de pagamento (Pix + cartões aceitos via Mercado Pago).
  SVGs inline, sem dependência externa. Usado na PDP (pdp-price-box).
{%- endcomment -%}
<ul class="pay-icons" aria-label="Formas de pagamento aceitas">
  <li class="pay-icon" title="Pix">
    <svg viewBox="0 0 48 30" role="img" aria-label="Pix"><rect width="48" height="30" rx="4" fill="#fff" stroke="#e5e7eb"/><g transform="translate(8,4.5)"><path d="M10.5 0.8 L16 6.3 a2.6 2.6 0 0 1 0 3.7 L10.5 15.5 a2.6 2.6 0 0 1 -3.7 0 L1.3 10 a2.6 2.6 0 0 1 0 -3.7 L6.8 0.8 a2.6 2.6 0 0 1 3.7 0 Z" fill="none" stroke="#32BCAD" stroke-width="1.6"/><path d="M4.6 5.4 q2 -0.4 3.2 0.9 l1.4 1.5 1.4 -1.5 q1.2 -1.3 3.2 -0.9" fill="none" stroke="#32BCAD" stroke-width="1.4" stroke-linecap="round"/><path d="M4.6 10.9 q2 0.4 3.2 -0.9 l1.4 -1.5 1.4 1.5 q1.2 1.3 3.2 0.9" fill="none" stroke="#32BCAD" stroke-width="1.4" stroke-linecap="round"/></g><text x="30" y="19" font-family="Arial,Helvetica,sans-serif" font-size="9" font-weight="bold" fill="#32BCAD">PIX</text></svg>
  </li>
  <li class="pay-icon" title="Visa">
    <svg viewBox="0 0 48 30" role="img" aria-label="Visa"><rect width="48" height="30" rx="4" fill="#fff" stroke="#e5e7eb"/><text x="24" y="20" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="12" font-weight="bold" font-style="italic" fill="#1A1F71">VISA</text></svg>
  </li>
  <li class="pay-icon" title="Mastercard">
    <svg viewBox="0 0 48 30" role="img" aria-label="Mastercard"><rect width="48" height="30" rx="4" fill="#fff" stroke="#e5e7eb"/><circle cx="20" cy="15" r="8.5" fill="#EB001B"/><circle cx="28" cy="15" r="8.5" fill="#F79E1B" fill-opacity="0.9"/><path d="M24 8.6a8.5 8.5 0 0 1 0 12.8 8.5 8.5 0 0 1 0-12.8Z" fill="#FF5F00"/></svg>
  </li>
  <li class="pay-icon" title="Elo">
    <svg viewBox="0 0 48 30" role="img" aria-label="Elo"><rect width="48" height="30" rx="4" fill="#000"/><text x="24" y="20" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="12" font-weight="bold" fill="#fff">el<tspan fill="#FFCB05">o</tspan></text></svg>
  </li>
  <li class="pay-icon" title="American Express">
    <svg viewBox="0 0 48 30" role="img" aria-label="American Express"><rect width="48" height="30" rx="4" fill="#2E77BC"/><text x="24" y="18" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="8.5" font-weight="bold" fill="#fff">AMEX</text></svg>
  </li>
  <li class="pay-icon" title="Hipercard">
    <svg viewBox="0 0 48 30" role="img" aria-label="Hipercard"><rect width="48" height="30" rx="4" fill="#B3131B"/><text x="24" y="18.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="7" font-weight="bold" fill="#fff">Hipercard</text></svg>
  </li>
  <li class="pay-icon" title="Mercado Pago">
    <svg viewBox="0 0 48 30" role="img" aria-label="Mercado Pago"><rect width="48" height="30" rx="4" fill="#fff" stroke="#e5e7eb"/><ellipse cx="24" cy="12" rx="13" ry="8" fill="none" stroke="#009EE3" stroke-width="1.6"/><path d="M17 12.2c2-2 3.6-2 5 -0.6l2 1.9c1 1 2.4 1 3.4 0.1 1.2-1 2.6-1.4 3.6-1.2" fill="none" stroke="#009EE3" stroke-width="1.3" stroke-linecap="round"/><text x="24" y="26.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="6" font-weight="bold" fill="#009EE3">Mercado Pago</text></svg>
  </li>
</ul>
